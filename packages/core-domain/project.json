{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "core-domain",
  "sourceRoot": "packages/core-domain/src",
  "projectType": "library",
  "tags": ["scope:packages", "type:domain"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/core-domain",
        "tsConfig": "packages/core-domain/tsconfig.lib.json",
        "main": "packages/core-domain/src/index.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/core-domain/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/core-domain/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}